# Copy to .env. Process environment wins; .env.local is loaded before .env.
# Keep local user data isolated from production replication.
DB_PATH=interactions.db
TURSO_SYNC_DISABLED=1

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=arxiv_bgem3_dense
QDRANT_B_URL=
QDRANT_B_API_KEY=
QDRANT_B_COLLECTION=arxiv_dense_b
SEARCH_FANOUT_B=1
QDRANT_RECENT_URL=
QDRANT_RECENT_API_KEY=
QDRANT_RECENT_COLLECTION=arxiv_recent
SEARCH_FANOUT_RECENT=1

METADATA_SIDECAR_PATH=data/metadata.sqlite
SPARSE_BACKEND=fts
TURSO_URL=
TURSO_DB_TOKEN=
ZILLIZ_URI=
ZILLIZ_TOKEN=
GROQ_API_KEY=
# Optional: ordered Groq model chain (defaults in app/config.py). Re-evaluate
# with scripts/eval_groq_models.py when Groq announces a deprecation.
# GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b,openai/gpt-oss-120b

RERANKER_MODE=heuristic
SEARCH_BGE_RERANK=1
SEARCH_RERANK_TOP_N=10

# Optional companion map; configure a dedicated map store for isolation.
MAP_QDRANT_URL=
MAP_QDRANT_API_KEY=
MAP_QDRANT_COLLECTION=arxiv_map_positions
SPACE_APP_URL=
SPACE_SERVICE_TOKEN=

# HF discovery collection: opt-in shadow evaluation, not personalized serving.
# The app owns scheduling in shadow mode; do not also run the CLI watcher.
HF_DISCOVERY_MODE=off
HF_DISCOVERY_INTERVAL_SECONDS=21600
HF_DISCOVERY_BATCH_SIZE=10
HF_DISCOVERY_DB_PATH=data/discovery.sqlite
