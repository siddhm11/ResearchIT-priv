# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Environment
# Match every dotenv variant (.env.local, .env.production, ...), not just .env —
# a bare `.env` rule leaves `.env.local` committable, which is how live keys leak.
.env
.env.*
!.env.example
*.db

# Virtualenvs
.venv/
venv/

# IDE
.vscode/
.idea/
.claude/

# Cache
.pytest_cache/
.qodo/

# OS
.DS_Store
Thumbs.db

# PDFs (research docs, not code)
*.pdf

# Large data files
arxiv_ids.txt
e2e_output.txt

# Metadata sidecar — ~1.5GB, built by scripts/build_metadata_sidecar.py and
# fetched at image build time. Never commit it.
#
# `data/*` rather than `data/`: git cannot re-include a file whose parent
# DIRECTORY is excluded, so excluding the directory itself would make the
# negation below silently do nothing. Curated collections are small, hand-
# written content and must be version-controlled.
data/*
!data/collections/
*.sqlite

# Generated / scratch
pdf_images/
/search_out.html
/scripts/screenshot_*.png

# Notebooks (reference only — tracked selectively)
notebooks/02-bme-arxiv-test.ipynb
notebooks/03-check-search-bq-prm.ipynb

# Scratch / temp files
docs/walkthroughs/Untitled-1.txt

# One-off audit outputs (scripts/site_audit.py writes audit.json in the cwd).
/audit.json
/corpusprobe.json

# Regenerated by scripts/run_recommendation_audit.py and scripts/hf_discovery.py.
# README, integration plan and the fixture sample the tests read stay tracked;
# tests.xml embeds absolute local paths and must never be published.
reports/recommendations/index.html
reports/recommendations/results.json
reports/recommendations/tests.xml
reports/recommendations/hf-pipeline-status.json
reports/recommendations/integration-plan.html
reports/recommendations/shadow-demo/

# A separate git repository (an externally hosted assessment page), not project docs.
docs/project-review/

# Single-use release scripts pinned to past HEADs; they refuse to run today.
scripts/publish_*.sh
